<Window x:Class="WpfApp23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp23"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="Silver">

    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <Border BorderBrush="Red" BorderThickness="2">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Foreground="Red" FontSize="12"
               Text="{Binding [0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Width" Value="400"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="АНКЕТА" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" FontSize="50" HorizontalAlignment="Center"/>


        <TextBlock Text="ФИО" Grid.Column="0" Grid.Row="2"/>
        <TextBox Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="2"/>

        <TextBlock Text="Группа" Grid.Column="0" Grid.Row="3"/>
        <TextBox Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="3"/>

        <TextBlock Text="Возраст" Grid.Column="0" Grid.Row="4"/>
        <TextBox Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="4"/>

        <TextBlock Text="Курс" Grid.Column="0" Grid.Row="5"/>
        <ComboBox Grid.Column="1" Grid.Row="5" Margin="10" Width="100" HorizontalAlignment="Left"
                  Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Course, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
        </ComboBox>

        <CheckBox Content="Согласен с условиями" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Margin="10" FontSize="15"
                  Validation.ErrorTemplate="{StaticResource ErrorTemplate}" IsChecked="{Binding IsAgreed, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <Button Content="Сохранить" Click="Save_Click" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Margin="10" FontSize="15"/>


    </Grid>
</Window>
